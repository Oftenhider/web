{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "oftenhider-site",
  "compatibility_date": "2026-10-07",
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "routes": [
    {
      "pattern": "oftenhider.eu",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public"
  }
}
